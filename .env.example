# Copy this file to .env and supply your own local values.
# Never commit real API keys or passwords.

# JSearch API (only needed when collecting new postings)
JSEARCH_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_market_db
DB_USER=postgres
DB_PASSWORD=

# Application
APP_ENV=development
LOG_LEVEL=INFO
